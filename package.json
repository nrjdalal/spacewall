{
  "name": "spacewall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bash scripts/build.sh",
    "db-push": "bun --env-file=.env.development drizzle-kit push && bun --env-file=.env.development drizzle-kit generate",
    "db-push:prod": "bun --env-file=.env.production-db drizzle-kit push",
    "db-studio": "bun --env-file=.env.development drizzle-kit studio",
    "db-studio:prod": "bun --env-file=.env.production-db drizzle-kit studio",
    "deploy:dev": "bun --env-file=.env.development sst deploy --stage dev",
    "deploy:prod": "bun --env-file=.env.production sst deploy --stage prod",
    "dev": "next dev",
    "prepare": "if [ -z \"$VERCEL_ENV\" ]; then simple-git-hooks; fi",
    "update": "ncu --interactive --format group"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/pre-commit.sh",
    "commit-msg": "bunx commitlint --edit $1"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@aws-sdk/client-cloudfront": "^3.734.0",
    "@aws-sdk/client-s3": "^3.735.0",
    "@aws-sdk/s3-request-presigner": "^3.735.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@icons-pack/react-simple-icons": "^11.1.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.5",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@sindresorhus/slugify": "^2.2.1",
    "@tanstack/react-query": "^5.64.2",
    "@tanstack/react-table": "^8.20.6",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "compressorjs": "^1.2.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.18",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.0.9",
    "next": "15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zod-meta-parser": "^0.0.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3",
    "@pulumi/pulumi": "^3.147.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.64.2",
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "lint-staged": "^15.4.2",
    "npm-check-updates": "^17.1.14",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "simple-git-hooks": "^2.11.1",
    "sort-package-json": "^2.14.0",
    "sst": "^3.6.17",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.0"
}
