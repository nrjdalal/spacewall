{
  "name": "spacewall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "db-push": "bun --env-file=.env.development drizzle-kit push",
    "db-studio": "bun --env-file=.env.development drizzle-kit studio",
    "deploy:dev": "sst deploy --stage dev",
    "prepare": "if [ \"$VERCEL_ENV\" != \"production\" ]; then simple-git-hooks; fi",
    "update": "ncu --interactive --format group"
  },
  "packageManager": "bun@1.1.39",
  "simple-git-hooks": {
    "pre-commit": "bash scripts/simulate-build.sh",
    "commit-msg": "bunx commitlint --edit $1"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@aws-sdk/client-s3": "^3.713.0",
    "@aws-sdk/s3-request-presigner": "^3.713.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@tanstack/react-query": "^5.62.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compressorjs": "^1.2.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.2",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.0",
    "@tailwindcss/postcss": "^4.0.0-beta.8",
    "@tanstack/react-query-devtools": "^5.62.8",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "lint-staged": "^15.2.11",
    "npm-check-updates": "^17.1.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "simple-git-hooks": "^2.11.1",
    "sst": "^3.4.21",
    "tailwindcss": "^4.0.0-beta.8",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
